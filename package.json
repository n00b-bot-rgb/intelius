{
  "name": "intelius",
  "version": "1.0.0",
  "description": "Scraper for Intelius",
  "main": "src/index.js",
  "repository": "https://AJRedDevil@bitbucket.org/shilfu/intelius.git",
  "author": "Ajan Lal Shrestha <ajan.shresh@gmail.com>",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "bluebird": "3.5.4",
    "cheerio": "1.0.0-rc.2",
    "csv-writer": "1.2.0",
    "csvtojson": "2.0.8",
    "dotenv": "7.0.0",
    "js-yaml": "3.13.1",
    "jsonfile": "5.0.0",
    "lodash": "4.17.21",
    "log4js": "6.4.0",
    "puppeteer": "1.14.0",
    "xlsx": "0.17.0"
  },
  "scripts": {
    "setup": "node src/workflow/setup.js",
    "preflight": "node src/workflow/preflight.js",
    "preflight:ci": "PIPELINE_MODE=ci node src/workflow/preflight.js",
    "validate": "yarn setup && yarn preflight:ci",
    "start": "NODE_ENV=production node src/index.js",
    "start:dev": "NODE_ENV=development node src/index.js",
    "start:debug": "NODE_ENV=debug node src/index.js",
    "start:play": "node playground/index.js",
    "workflow": "yarn setup && yarn preflight && yarn start",
    "install:ci": "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 yarn install --frozen-lockfile"
  }
}